{
  "name": "kanso-cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm --filter @kanso/admin build && pnpm --filter @kanso/server build",
    "deploy": "pnpm build && pnpm --filter @kanso/server deploy",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check": "biome check .",
    "format": "biome format --write .",
    "types": "pnpm --filter @kanso/server types",
    "db:generate": "pnpm --filter @kanso/core db:generate",
    "db:migrate:local": "pnpm --filter @kanso/server db:migrate:local",
    "db:migrate": "pnpm --filter @kanso/server db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
