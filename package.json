{
  "name": "kanso-cms",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter './apps/*' -r --parallel --stream dev",
    "build": "pnpm --filter @kanso/admin build && pnpm --filter @kanso/server build",
    "deploy": "pnpm build && pnpm --filter @kanso/server run deploy",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check": "biome check .",
    "format": "biome format --write .",
    "types": "pnpm --filter @kanso/server types",
    "db:generate": "pnpm --filter @kanso/core db:generate",
    "db:migrate:local": "pnpm --filter @kanso/server db:migrate:local",
    "db:migrate": "pnpm --filter @kanso/server db:migrate",
    "passkey:link": "pnpm --filter @kanso/server passkey:link",
    "setup:token": "pnpm --filter @kanso/server setup:token"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
