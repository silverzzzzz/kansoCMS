---
import { PUBLIC_SITE_TITLE } from 'astro:env/client'
import { getPages } from '../lib/kanso.ts'

interface Props {
  title?: string
}

const { title } = Astro.props
const pages = (await getPages())
  .filter((page) => page.parentId === null)
  .sort((a, b) => a.sortOrder - b.sortOrder)
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${PUBLIC_SITE_TITLE}` : PUBLIC_SITE_TITLE}</title>
  </head>
  <body>
    <header>
      <a class="site-title" href="/">{PUBLIC_SITE_TITLE}</a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        {pages.map((page) => <a href={`/${page.path}/`}>{page.title}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer>Powered by kansoCMS</footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --background: #faf9f6;
    --text: #292722;
    --muted: #64605a;
    --line: #d9d5cc;
    --link: #265d69;
    font-family: system-ui, sans-serif;
    line-height: 1.75;
    background: var(--background);
    color: var(--text);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --background: #1c1e20;
      --text: #eeece5;
      --muted: #b7b5ae;
      --line: #494a46;
      --link: #94ccd4;
    }
  }
  * { box-sizing: border-box; }
  body { max-width: 52rem; margin: 0 auto; padding: 0 1.25rem; }
  header { padding: 2.5rem 0 1.5rem; border-bottom: 1px solid var(--line); }
  .site-title { font-size: 1.3rem; font-weight: 700; text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 1rem; }
  main { min-height: 55vh; padding: 2rem 0 3rem; }
  footer { padding: 1.5rem 0; border-top: 1px solid var(--line); color: var(--muted); }
  a { color: var(--link); text-underline-offset: 0.2em; }
  a:hover { text-decoration-thickness: 0.15em; }
  :focus-visible { outline: 2px solid var(--link); outline-offset: 4px; }
  h1, h2, h3 { line-height: 1.3; text-wrap: balance; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.8rem); }
  img { display: block; max-width: 100%; height: auto; }
  .cover { margin: 1.5rem 0; border-radius: 0.25rem; }
  .thumbnail { width: 12rem; max-height: 9rem; object-fit: cover; }
  .post-list { list-style: none; padding: 0; }
  .post-list > li { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .post-list h2 { margin-top: 0; }
  time, .terms { color: var(--muted); font-size: 0.9rem; }
  .content { overflow-wrap: anywhere; }
  .content pre { overflow-x: auto; padding: 1rem; border: 1px solid var(--line); }
  .content blockquote { margin-left: 0; padding-left: 1rem; border-left: 3px solid var(--line); }
  .content table { display: block; overflow-x: auto; border-collapse: collapse; }
  .content td, .content th { padding: 0.5rem; border: 1px solid var(--line); }
  .form-placeholder { padding: 1rem; border: 1px dashed var(--line); color: var(--muted); }
</style>
