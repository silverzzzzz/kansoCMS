{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanso",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets (admin SPA build + public/). The Vite plugin fills in
  // `directory` at build time. Assets are matched BEFORE the Worker runs;
  // `not_found_handling: none` hands every miss to Hono so the public site
  // owns its own 404 and /_admin/* falls back to the SPA shell in admin.ts.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // D1 and R2 need no ids: the first `pnpm run deploy` creates the database and the bucket
  // under these names, or silently connects to existing ones with the same names in the account,
  // so give each site its own names. An interactive deploy writes the real `database_id` back
  // into this file (and reformats it): commit it in a site's repository, never upstream.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanso",
      // Local development only: names the database file under .wrangler/state, so local data
      // stays where it is with or without a production `database_id`. The deploy output lists
      // this placeholder next to env.DB, but the deployed Worker uses the real database.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/core/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "kanso-media"
    }
  ],

  // Optional: Workers AI for the admin "AI で生成" assist (excerpt / SEO description / alt).
  // Off by default. An AI binding always connects to Cloudflare, so with it enabled
  // `pnpm dev` needs `wrangler login` (or CLOUDFLARE_API_TOKEN) and requests are billed
  // to your account. Uncomment to enable:
  // "ai": { "binding": "AI" },

  // Daily housekeeping at 18:00 UTC (03:00 in Japan): empties trash older than 30 days
  // and removes expired share links, sessions and registration links.
  "triggers": { "crons": ["0 18 * * *"] },

  // Local development emulates delivery; adding "remote": true would send real email.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    // Absolute origin used for canonical URLs, sitemap and JSON-LD.
    "SITE_URL": "http://localhost:5173"
  },

  // Secrets (set with `wrangler secret put`, or copy .dev.vars.example to .dev.vars locally):
  //   TURNSTILE_SECRET_KEY=...
  //   SETUP_TOKEN=...   /_admin/setup outside localhost refuses to run without it (`pnpm setup:token`)

  "observability": {
    "enabled": true
  }
}
